# --- Required ---------------------------------------------------------------
# PostgreSQL connection string. `docker compose up -d` starts one matching this.
DATABASE_URL=postgres://quiz:quiz@localhost:5433/quiz
# Set to true for hosted databases that require SSL (Neon on Vercel, Supabase, ...).
DATABASE_SSL=false

# Long random string used to sign session cookies (required in production).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Public URL of the app — used to build the links in invitation emails.
APP_URL=http://localhost:3000
PORT=3000
APP_NAME=Quiz Portal

# Only if the app sits behind a reverse proxy but APP_URL is http:// (rare).
# By default the proxy is trusted only when APP_URL starts with https://.
TRUST_PROXY=

# Time zone for dates in CSV exports, e.g. Asia/Colombo or Europe/London.
# Pages already show dates in each viewer's own time zone. Empty = the
# server's time zone (UTC on Vercel and in Docker).
APP_TIMEZONE=

# --- First admin -------------------------------------------------------------
# If set, this admin is created on startup when it doesn't exist yet.
# Locally you can leave these empty and create the admin in the browser at /admin.
# On a live server (NODE_ENV=production) browser setup is disabled, so set them.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty in development: emails are printed to the console and
# the admin sees each person's link + password on screen to share manually.
#
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true and an App Password
#        (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quiz Portal <no-reply@example.com>"

# --- Only for docker-compose.prod.yml ------------------------------------------
# Password for the bundled PostgreSQL database (choose any long random string).
POSTGRES_PASSWORD=
# Port on the server that the app is published on.
APP_PORT=3000
