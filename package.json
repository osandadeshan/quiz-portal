{
  "name": "quiz-portal",
  "version": "2.0.0",
  "description": "Quiz platform with admin quiz builder, emailed per-user credentials, timed attempts with auto-submit, and ranked results.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "reset-password": "node scripts/reset-admin-password.js",
    "test:e2e": "playwright test -c src/tests",
    "test:api": "playwright test -c src/tests --project=api",
    "test:ui": "playwright test -c src/tests --project=chromium",
    "test:e2e:headed": "playwright test -c src/tests --headed",
    "test:e2e:report": "allure generate src/tests/.output/allure-results -o src/tests/.output/allure-report --clean --name \"Quiz Portal E2E\" && allure open src/tests/.output/allure-report",
    "test:e2e:doc": "tsx src/tests/e2e/scripts/generate-doc.ts",
    "test:e2e:typecheck": "tsc -p src/tests",
    "pretest:e2e": "node -e \"require('fs').rmSync('src/tests/.output/allure-results',{recursive:true,force:true})\"",
    "pretest:api": "node -e \"require('fs').rmSync('src/tests/.output/allure-results',{recursive:true,force:true})\"",
    "pretest:ui": "node -e \"require('fs').rmSync('src/tests/.output/allure-results',{recursive:true,force:true})\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "node-html-parser": "^7.0.1",
    "nodemon": "^3.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "ignore": [
      "src/tests/*",
      "node_modules/*"
    ]
  }
}
