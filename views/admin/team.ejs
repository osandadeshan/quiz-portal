<%- include('../partials/admin-top') %>
<div class="page-header">
  <div>
    <h1>Team</h1>
    <p class="subtitle">Each admin has their own private quizzes and results. Other admins can't see them.<% if (!isOwner) { %> Only the owner can add or remove admins.<% } %></p>
  </div>
  <% if (isOwner) { %><button type="button" class="btn btn-primary" data-open-dialog="add-admin"><%- icon('plus', 16) %> Add admin</button><% } %>
</div>
<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Admin</th><th class="hide-sm">Added</th><th class="hide-sm">Last sign-in</th><th></th></tr></thead>
      <tbody>
      <% admins.forEach(function (a) { %>
        <tr>
          <td><div class="person"><span class="avatar"><%= fmt.initials(a.name, a.email) %></span><div style="min-width:0"><div class="person-name"><%= a.name %> <% if (a.role === 'owner') { %><span class="badge badge-warning" title="The owner manages the team"><%- icon('shield', 12) %> Owner</span><% } %> <% if (a.id === admin.id) { %><span class="badge badge-primary">You</span><% } %></div><div class="person-email"><%= a.email %></div></div></div></td>
          <td class="hide-sm muted"><%- fmt.localTime(a.created_at) %></td>
          <td class="hide-sm muted"><%- a.last_login_at ? fmt.localTime(a.last_login_at) : 'Never' %></td>
          <td class="num">
            <% if (isOwner && a.id !== admin.id) { %>
              <details class="dropdown">
                <summary class="btn btn-ghost btn-icon btn-sm" aria-label="Actions for <%= a.email %>"><%- icon('more', 16) %></summary>
                <div class="dropdown-menu">
                  <form method="post" action="/admin/team/<%= a.id %>/password" data-confirm="A new password is created and shown to you once. Their current password stops working and they're signed out everywhere." data-confirm-title="Reset <%= a.name %>'s password?" data-confirm-btn="Reset password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="menu-item"><%- icon('lock', 16) %> Reset password</button></form>
                  <div class="menu-sep"></div>
                  <form method="post" action="/admin/team/<%= a.id %>/delete" data-confirm="<%= a.name %> will no longer be able to sign in. Their quizzes and results will be moved to your account." data-confirm-title="Remove this admin?" data-confirm-btn="Remove" data-danger><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="menu-item danger"><%- icon('trash', 16) %> Remove admin</button></form>
                </div>
              </details>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% if (isOwner) { %>
<dialog class="modal" id="add-admin" <%= typeof openForm !== 'undefined' && openForm ? 'data-open-on-load' : '' %>>
  <form method="post" action="/admin/team" data-loading novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-body">
      <div class="modal-icon"><%- icon('shield', 22) %></div>
      <h3>Add an admin</h3>
      <p style="margin-bottom:18px">Share the email and password with them so they can sign in. They can change their password from the Account page.</p>
      <div class="field <%= errors.name ? 'has-error' : '' %>">
        <label class="label" for="a-name">Full name</label>
        <input class="input" id="a-name" name="name" value="<%= values.name || '' %>" required>
        <% if (errors.name) { %><span class="field-error"><%= errors.name %></span><% } %>
      </div>
      <div class="field <%= errors.email ? 'has-error' : '' %>">
        <label class="label" for="a-email">Email</label>
        <input class="input" id="a-email" name="email" type="email" value="<%= values.email || '' %>" required>
        <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
      </div>
      <div class="field <%= errors.password ? 'has-error' : '' %>">
        <label class="label" for="a-pass">Temporary password</label>
        <div class="input-group">
          <input class="input" id="a-pass" name="password" type="text" minlength="8" required autocomplete="off">
          <button type="button" class="btn btn-ghost btn-sm input-addon" data-generate-password="a-pass" title="Generate a password"><%- icon('refresh', 14) %></button>
        </div>
        <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } else { %><span class="hint">At least 8 characters. Click the arrows to generate one.</span><% } %>
      </div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn" data-close-dialog>Cancel</button>
      <button class="btn btn-primary"><span class="spinner"></span> Add admin</button>
    </div>
  </form>
</dialog>
<% } %>
<%- include('../partials/admin-bottom') %>
